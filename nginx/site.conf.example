# Beispiel: statische Website hinter nginx (optional hinter Cloudflare)
# Pfade/Domain anpassen, dann:  nginx -t && systemctl reload nginx
server {
    listen 443 ssl;
    http2 on;
    server_name example.org;
    root /var/www/example.org;

    # ssl_certificate     /etc/letsencrypt/live/example.org/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/example.org/privkey.pem;

    index index.html;
    charset utf-8;
    server_tokens off;
    gzip_static on;                       # vorkomprimierte *.gz direkt ausliefern

    include snippets/security-headers.conf;

    # Echte 404 statt Startseite (KEIN try_files ... /index.html bei Mehrseiten-Sites)
    error_page 404 /404.html;
    location = /404.html { internal; }

    # Dotfiles sperren (.git, .env, .htaccess …), .well-known erlauben
    location ^~ /.well-known/ { try_files $uri =404; }
    location ~ /\.            { return 404; }

    # Nur lesende Methoden
    if ($request_method !~ ^(GET|HEAD|OPTIONS)$) { return 405; }

    location / { try_files $uri $uri/ =404; }

    # Service Worker und HTML nie lange cachen – sonst kommen Updates nicht an
    location = /sw.js {
        include snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }
    location ~* \.html$ {
        include snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }
    # CSS/JS ohne Hash im Dateinamen: moderat cachen
    location ~* \.(css|js|webmanifest|svg|json)$ {
        include snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=604800" always;
        try_files $uri =404;
    }
    location ~* \.(woff2|png|jpg|jpeg|webp|ico)$ {
        include snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }
}

server {
    listen 80;
    server_name example.org;
    return 301 https://$host$request_uri;
}
